# Production template for IT-TECH eKYC. Copy to .env and fill every value.
# Generate secrets with: python -m scripts.generate_secrets
EKYC_ENVIRONMENT=production
EKYC_BASE_URL=https://ekyc.example.com

# Managed PostgreSQL (never SQLite in production)
EKYC_DATABASE_URL=postgresql+psycopg2://ekyc:CHANGE_ME@postgres:5432/ekyc
EKYC_REDIS_URL=redis://redis:6379/0
# Heavy work (OCR, biometrics, PDF, webhooks) runs on Celery workers
EKYC_CELERY_ALWAYS_EAGER=false

# Secrets (MANDATORY - no defaults in production)
EKYC_ADMIN_API_KEY=REPLACE_WITH_GENERATED_SECRET
EKYC_JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Encrypted object storage (S3-compatible, server-side encryption enabled in code)
# Enable Object Lock / WORM on this bucket for tamper-proof audit checkpoints.
EKYC_STORAGE_BACKEND=s3
EKYC_S3_BUCKET=ekyc-archive
EKYC_S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
EKYC_S3_REGION=eu-west-1

# In-house eKYC engines (self-hosted, no third-party SaaS)
EKYC_OCR_PROVIDER=inhouse
EKYC_FACE_PROVIDER=inhouse
EKYC_BIOMETRICS_MODEL_DIR=/srv/ekyc/var/models
EKYC_ANTISPOOF_MODEL=antispoof_quantized.onnx
# Decision thresholds (tune against your validation set)
EKYC_FACE_MATCH_THRESHOLD=0.80
EKYC_LIVENESS_THRESHOLD=0.70
EKYC_DOCUMENT_REVIEW_THRESHOLD=0.60
EKYC_RISK_REVIEW_THRESHOLD=50
EKYC_RISK_ACCEPT_THRESHOLD=80
EKYC_FACE_MATCH_COS_REJECT=0.25
EKYC_FACE_MATCH_COS_ACCEPT=0.55

# OTP delivery via your own SMS/email gateway
EKYC_OTP_PROVIDER=http
EKYC_OTP_HTTP_URL=https://sms-gateway.internal/send
EKYC_OTP_HTTP_AUTH_HEADER=Bearer REPLACE_WITH_GATEWAY_TOKEN

# Evidence: key material and qualified timestamping
EKYC_SIGNING_BACKEND=local
EKYC_SIGNING_KEY_PATH=/srv/ekyc/var/keys/signing_key.pem
EKYC_SIGNING_CERT_PATH=/srv/ekyc/var/keys/signing_cert.pem
EKYC_SIGNING_DEV_SELF_SIGNED_CERT=false
# RFC 3161 Timestamp Authority (without it timestamps are flagged non-qualified)
EKYC_TSA_URL=https://tsa.example.com/tsr
# Only the final KYC certificate uses the paid TSA; contracts use local soft timestamps.
EKYC_TSA_QUALIFIED_CERTIFICATES=false
