# Trusdy National — production env template.
# install.sh generates all secrets; this file documents every required key.

EKYC_ENVIRONMENT=production
EKYC_BASE_URL=https://ekyc.EXAMPLE.tld

POSTGRES_PASSWORD=__GENERATED__
EKYC_DATABASE_URL=postgresql+psycopg2://ekyc:__GENERATED__@postgres:5432/ekyc
EKYC_REDIS_URL=redis://redis:6379/0
EKYC_CELERY_ALWAYS_EAGER=false

EKYC_ADMIN_API_KEY=__GENERATED__
EKYC_JWT_SECRET=__GENERATED__

EKYC_STORAGE_BACKEND=local
EKYC_STORAGE_ROOT=/srv/ekyc/var/storage
EKYC_STORAGE_ENCRYPTION=true
EKYC_KEK=__GENERATED_64HEX__
EKYC_KEK_VERSION=1

EKYC_OCR_PROVIDER=inhouse
EKYC_FACE_PROVIDER=inhouse
EKYC_BIOMETRICS_MODEL_DIR=/srv/ekyc/var/models
EKYC_GPU_ENABLED=false
EKYC_ANTISPOOF_MODEL=antispoof_quantized.onnx

EKYC_OTP_PROVIDER=http
EKYC_OTP_HTTP_URL=
EKYC_OTP_HTTP_AUTH_HEADER=
EKYC_OTP_HTTP_BODY_TEMPLATE=
EKYC_OTP_HTTP_ERROR_FIELD=status
EKYC_OTP_HTTP_ERROR_VALUE=error
EKYC_OTP_SMS_SENDER_ID=TRUSDY

EKYC_SIGNING_BACKEND=local
EKYC_SIGNING_KEY_PATH=/srv/ekyc/var/keys/signing_key.pem
EKYC_SIGNING_CERT_PATH=/srv/ekyc/var/keys/signing_cert.pem
EKYC_SIGNING_DEV_SELF_SIGNED_CERT=false
EKYC_TSA_URL=
EKYC_CSCA_DIR=/srv/ekyc/var/keys/csca

# Country-profile gate (mandatory in production deployments)
EKYC_REQUIRE_COUNTRY_PROFILE=true
EKYC_COUNTRY_PROFILE=/srv/ekyc/var/country-profiles/PROFILE.json
EKYC_CENTRAL_PUBLIC_KEY=

# Central heartbeat + manifest sync (optional but recommended)
EKYC_CENTRAL_URL=
EKYC_INSTANCE_ID=
EKYC_INSTANCE_KEY_PATH=/srv/ekyc/var/keys/instance_ed25519.pem
