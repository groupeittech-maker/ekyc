# Toutes les variables sont prefixees par EKYC_
EKYC_ENVIRONMENT=development
EKYC_BASE_URL=http://localhost:8000

EKYC_DATABASE_URL=postgresql+psycopg2://ekyc:ekyc@localhost:5432/ekyc
EKYC_REDIS_URL=redis://localhost:6379/0
# En production, les traitements lourds passent par Celery: mettre false
EKYC_CELERY_ALWAYS_EAGER=false

# Secrets: generer avec `python -c "import secrets; print(secrets.token_urlsafe(48))"`
EKYC_ADMIN_API_KEY=change-me-admin-key
EKYC_JWT_SECRET=change-me-jwt-secret

# Archivage electronique
EKYC_STORAGE_BACKEND=local
EKYC_STORAGE_ROOT=./var/storage
# EKYC_STORAGE_BACKEND=s3
# EKYC_S3_BUCKET=ekyc-archive
# EKYC_S3_ENDPOINT_URL=
# EKYC_S3_REGION=eu-west-1

# Moteurs (stub = deterministe, pour developpement et demonstration)
# inhouse = module eKYC maison (OpenCV + Tesseract, auto-heberge, sans SaaS tiers)
EKYC_OCR_PROVIDER=stub
EKYC_FACE_PROVIDER=stub
# EKYC_OCR_PROVIDER=inhouse
# EKYC_FACE_PROVIDER=inhouse
# Modeles ONNX locaux (provisionner avec: python -m scripts.fetch_models)
# EKYC_BIOMETRICS_MODEL_DIR=./var/models
EKYC_OTP_PROVIDER=log
# EKYC_OTP_PROVIDER=http
# EKYC_OTP_HTTP_URL=https://sms-gateway.example/send
# EKYC_OTP_HTTP_AUTH_HEADER=Bearer xxxxx

# Signature et horodatage
EKYC_SIGNING_KEY_PATH=./var/keys/signing_key.pem
# EKYC_SIGNING_CERT_PATH=./var/keys/signing_cert.pem
# Sans TSA, l'horodatage est "soft" et marque non qualifie
# EKYC_TSA_URL=https://freetsa.org/tsr

# Seuils de decision
EKYC_FACE_MATCH_THRESHOLD=0.80
EKYC_LIVENESS_THRESHOLD=0.70
EKYC_DOCUMENT_REVIEW_THRESHOLD=0.60
